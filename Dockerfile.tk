# The REAL Tkinter app, shown in a browser tab (virtual screen + noVNC). Build:  docker build -f Dockerfile.tk -t liquidityx-tk .
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-tk python3-numpy python3-networkx python3-matplotlib \
    xvfb x11vnc novnc websockify fonts-dejavu-core && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY main.py ./
COPY liquidityx ./liquidityx
COPY tk_in_browser/start.sh ./start.sh
EXPOSE 8080
CMD ["sh", "/app/start.sh"]
